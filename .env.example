# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.

# SURF_AI_model 패키지를 import 할 수 있는 경로
PROJECT_ROOT=/srv/projects/surf
VENV_PATH=

SERVER_PORT=5000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 판정 캐시 유지 시간(초). 길수록 서버 부하가 줄지만 모델 교체 반영이 늦어진다.
PREDICT_CACHE_TTL=21600
# 차단 기록 유지 시간(초). 확장이 /check 로 조회할 수 있는 창이다.
BLOCK_MARK_TTL=300
# 임시 허용 시간(초). 차단 페이지의 "30분 임시 허용"과 맞춰야 한다.
TEMP_ALLOW_TTL=1800

# 기기당 분당 요청 상한. 0 이면 제한 없음.
RATE_LIMIT_PER_MIN=600

# CPU 추론 스레드 수. gunicorn 워커 수와 곱해 코어 수를 넘지 않게 잡는다.
TORCH_THREADS=2

# CORS 허용 오리진. 쉼표로 구분하며 * 는 전체 허용이다.
CORS_ORIGINS=*

GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_LOGLEVEL=info
